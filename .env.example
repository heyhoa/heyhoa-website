# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# Accounting provider: mock | frontsteps
ACCOUNTING_PROVIDER=mock

# FrontSteps / Caliber API (CAPI2). Sandbox base URL shown; swap for your tenant URL.
FRONTSTEPS_BASE_URL=https://frontsteps.cloud/CAPI2_APISandbox
FRONTSTEPS_API_KEY=
# Optional: owner/board username:password for scoped calls (Basic auth header)
FRONTSTEPS_USERNAME=
FRONTSTEPS_PASSWORD=

# AI (optional). Leave blank to run in deterministic demo mode.
ANTHROPIC_API_KEY=
HEY_AI_MODEL=claude-opus-5-5

# Lead notifications (optional)
LEAD_NOTIFY_EMAIL=hello@heyhoa.com

# Help Scout: shared inbox + tickets (Help Scout → Manage → Apps → My Apps → OAuth2 client credentials)
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=
HELPSCOUT_WEBHOOK_SECRET=
HELPSCOUT_MAILBOX_ID_SUPPORT=
HELPSCOUT_MAILBOX_ID_SALES=
# Help Scout user ids to assign non-auto tickets to, per route
HELPSCOUT_ASSIGNEE_COORDINATOR=
HELPSCOUT_ASSIGNEE_ACCOUNTANT=
HELPSCOUT_ASSIGNEE_BOARD=
# Per-community inbound aliases → community id
COMMUNITY_ALIASES=willowcreek@heyhoa.com=1001
# Slack incoming webhook for lead pings (optional)
SLACK_WEBHOOK_URL=

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# Accounting provider: mock | frontsteps
ACCOUNTING_PROVIDER=mock

# FrontSteps / Caliber API (CAPI2). Sandbox base URL shown; swap for your tenant URL.
FRONTSTEPS_BASE_URL=https://frontsteps.cloud/CAPI2_APISandbox
FRONTSTEPS_API_KEY=
# Optional: owner/board username:password for scoped calls (Basic auth header)
FRONTSTEPS_USERNAME=
FRONTSTEPS_PASSWORD=

# AI (optional). Leave blank to run in deterministic demo mode.
ANTHROPIC_API_KEY=
HEY_AI_MODEL=claude-opus-5-5

# Lead notifications (optional)
LEAD_NOTIFY_EMAIL=hello@heyhoa.com
# Sign-in: demo pick-a-role login (set false in production), cookie security, trusted-device window
DEMO_LOGIN=true
SESSION_COOKIE_SECURE=false
MFA_TRUST_DAYS=30
# Sales identity. Sequence A and proposals are signed by the founder; replies to FOUNDER_EMAIL hit the
# Postmark inbound webhook, mark the lead replied and stop the sequence.
FOUNDER_NAME=Austin Heywood
FOUNDER_FIRST=Austin
FOUNDER_TITLE=founder, hey hoa
FOUNDER_EMAIL=austin@heyhoa.com
# Onboarding: opening deposit floor for the new operating account, and where start-up checks go
STARTUP_CHECK_MIN=2500
LOCKBOX_ADDRESS=hey hoa · PO Box 00000 · Phoenix, AZ 85000
# Physical mail via Lob (optional). Unset = letters are recorded, then printed and mailed by a person.
LOB_API_KEY=
LOB_FROM_ADDRESS=
LETTER_COST=1.45
# Cyber insurance referral link shown in terms and the insurance page
CYBER_INSURANCE_URL=https://www.coalitioninc.com/
AGREEMENT_VERSION=2026-10
# 15-minute board walkthrough booking page (Cal.com or Calendly)
BOOKING_URL=https://cal.com/heyhoa/15min

# Email transport: Postmark. Inbound webhook URL: https://<host>/api/webhooks/postmark?token=<POSTMARK_INBOUND_TOKEN>
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_TOKEN=
POSTMARK_FROM=hey@heyhoa.com
# Per-community inbound aliases → community id (route inbound mail to the right community)
COMMUNITY_ALIASES=willowcreek@heyhoa.com=1001
# Text transport: Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Slack incoming webhook for lead pings (optional)
SLACK_WEBHOOK_URL=

# MCP server for owners', boards', vendors' and closing parties' own agents (python -m app.mcp_server)
MCP_TRANSPORT=stdio
MCP_PORT=8765
MCP_PUBLIC_URL=https://mcp.heyhoa.com/mcp
# token:role:community_id:unit_account_or_contact_id:name  (comma separated). Issued from the portals in Phase 2.
HEY_MCP_TOKENS=
# stdio/dev only: role:community_id:unit_account_id:name
HEY_MCP_DEFAULT_PERSONA=homeowner:1001:ua-1012:Marcus Reed

# Agent policy. Shadow mode = every proposal waits for a person in hey ops.
SHADOW_MODE=true
LIVE_COMMUNITIES=
AUTO_CONFIDENCE=0.8

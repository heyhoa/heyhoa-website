# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# Accounting provider: mock | frontsteps
ACCOUNTING_PROVIDER=mock

# FrontSteps / Caliber API (CAPI2). Sandbox base URL shown; swap for your tenant URL.
FRONTSTEPS_BASE_URL=https://frontsteps.cloud/CAPI2_APISandbox
FRONTSTEPS_API_KEY=
# Optional: owner/board username:password for scoped calls (Basic auth header)
FRONTSTEPS_USERNAME=
FRONTSTEPS_PASSWORD=

# AI (optional). Leave blank to run in deterministic demo mode.
ANTHROPIC_API_KEY=
HEY_AI_MODEL=claude-opus-5-5

# Lead notifications (optional)
LEAD_NOTIFY_EMAIL=hello@heyhoa.com

# Email transport: Postmark. Inbound webhook URL: https://<host>/api/webhooks/postmark?token=<POSTMARK_INBOUND_TOKEN>
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_TOKEN=
POSTMARK_FROM=hey@heyhoa.com
# Per-community inbound aliases → community id (route inbound mail to the right community)
COMMUNITY_ALIASES=willowcreek@heyhoa.com=1001
# Text transport: Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Slack incoming webhook for lead pings (optional)
SLACK_WEBHOOK_URL=

# Agent policy. Shadow mode = every proposal waits for a person in hey ops.
SHADOW_MODE=true
LIVE_COMMUNITIES=
AUTO_CONFIDENCE=0.8
